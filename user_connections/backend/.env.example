# PostgreSQL (SQLAlchemy URL, NOT the jdbc: form). Fill in your DB user + password.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/learning_webrtc

# Must be IDENTICAL in signal_server/.env
JWT_SECRET=change-me-long-random-string
JWT_EXPIRE_HOURS=12

# Must be IDENTICAL in signal_server/.env (server-to-server auth)
INTERNAL_API_KEY=change-me-another-random-string
SIGNAL_SERVER_URL=http://localhost:8001

# Only matters if a browser calls the backend directly (not via the frontend proxy)
CORS_ORIGINS=http://localhost:5173

# STUN/TURN servers given to the apps. Add a TURN server here in Step 5.
ICE_SERVERS_JSON=[{"urls": "stun:stun.l.google.com:19302"}]

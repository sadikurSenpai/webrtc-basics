# Port the Vite dev server listens on (this is the port you share via ngrok).
FRONTEND_PORT=5173

# Where the other two servers run. The Vite dev server PROXIES to them:
#   browser → /api/*  → BACKEND_URL/api/*
#   browser → /ws     → SIGNAL_SERVER_URL/ws   (WebSocket)
# So the browser only ever talks to ONE origin: this frontend.
BACKEND_URL=http://localhost:8000
SIGNAL_SERVER_URL=http://localhost:8001

# Optional "direct mode": leave empty to use the proxy (recommended).
# Set these only if you expose backend + signal server with their own public URLs,
# e.g. VITE_API_BASE=https://abc.ngrok-free.app/api
#      VITE_SIGNAL_WS_URL=wss://def.ngrok-free.app/ws
# (then also add the frontend's origin to CORS_ORIGINS in backend/.env)
VITE_API_BASE=
VITE_SIGNAL_WS_URL=
